# 复制成 .env 再按需修改：cp .env.example .env
# 或者直接跑 ./scripts/prepare.sh —— 它会自动创建 .env、补 PROJECT_DIR、
# 构建镜像、下载权重、启动并跑冒烟测试。
#
# 注意：.env 是本机配置，不进 git；这里只放默认值。

# ===== AI 生图（stable-diffusion.cpp + CUDA + SDXL 单文件 checkpoint）=====
# 镜像：国内如果拉不动 ghcr.io，改用南京大学镜像源
#SDCPP_IMAGE=ghcr.nju.edu.cn/leejet/stable-diffusion.cpp:master-cuda
SDCPP_IMAGE=ghcr.io/leejet/stable-diffusion.cpp:master-cuda
SDCPP_PORT=18234

# --- 当前生效的模型 ---
# 不要手改这里：用 ./scripts/use-model.sh <id> 切换（id 定义在 config/models.json），
# 它会同时更新这些字段和 web/model.json。
SD_MODEL_NAME="未选择"
SD_STYLE=custom
SD_MODEL_DIR=checkpoints
SD_MODEL_FILE=
SD_STEPS=28
SD_CFG_SCALE=6.0
SD_SAMPLER=euler_a
SD_WIDTH=1024
SD_HEIGHT=1024
SD_CLIP_SKIP=

# 可选：覆盖 VAE（文件名相对 models/checkpoints/）
#SD_CKPT_VAE=sdxl-vae-fp16-fix.safetensors

# 追加给 sd-server 的额外参数，例如：
#SDCPP_EXTRA_ARGS=--vae-tiling

# ===== 流程图 / 架构图（自建镜像：Mermaid CLI + Graphviz）=====
DIAGRAM_IMAGE=image-gen-diagram:local
DIAGRAM_PORT=18000
DIAGRAM_CONCURRENCY=2

# ===== 网页界面 =====
NGINX_IMAGE=nginx:1.27-alpine
WEB_PORT=18080

# ===== 自动选区（图生图的分割服务）=====
SEGMENTER_IMAGE=image-gen-segmenter:local
# 分割模型下载源（29MB，首次使用或 prepare 预热时下载）
HF_ENDPOINT=https://hf-mirror.com

# ===== 模型切换控制面（网页页头的写实/二次元按钮）=====
# 本仓库在本机的绝对路径。prepare.sh 会自动写入；手动部署时改成你的路径。
#PROJECT_DIR=/absolute/path/to/image-gen
# 只发布到 127.0.0.1；容器挂了 docker.sock，这个端口不能暴露到局域网
MANAGER_PORT=18235
MANAGER_IMAGE=image-gen-manager:local

# 监听地址：0.0.0.0 才能被 Windows / 局域网访问；只本机用改成 127.0.0.1
SDCPP_HOST=0.0.0.0

TZ=Asia/Shanghai
